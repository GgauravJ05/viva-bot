# Copy this file to .env and paste your own key below.
# Never share your .env file or put your key in code: .env is ignored by git.

# --- Main: Groq (free key, no credit card: https://console.groq.com/keys) ---
API_KEY=paste-your-groq-key-here
BASE_URL=https://api.groq.com/openai/v1
MODEL=openai/gpt-oss-120b

# --- Optional: Google Gemini instead (comment out the three lines above, uncomment these) ---
# Free key from https://aistudio.google.com/apikey. Pick MODEL from the Flash models listed there.
# API_KEY=paste-your-gemini-key-here
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL=gemini-flash-model-name-from-ai-studio

# --- App settings ---
COLLEGE_NAME=MES Lohia College
